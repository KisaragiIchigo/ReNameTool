{
  "meta": {
    "project_name": "NovaRename",
    "version": "1.0.2",
    "theme_mode": "clean_studio_light",
    "concept": "ファイル一括リネームツール"
  },
  "stack": {
    "framework": "Electron + React 18 + TypeScript",
    "bundler": "Vite",
    "styling": "Tailwind CSS v3",
    "icons": "lucide-react",
    "motion": "framer-motion",
    "primitives": "@radix-ui/react-*",
    "virtualization": "@tanstack/react-virtual"
  },
  "palette": {
    "bg_base": "#F8FAFC",
    "bg_surface": "#FFFFFF",
    "bg_surface_raised": "#F1F5F9",
    "bg_surface_hover": "#E2E8F0",
    "border_subtle": "rgba(15, 23, 42, 0.06)",
    "border_default": "rgba(15, 23, 42, 0.12)",
    "border_focus": "#2563EB",
    "text_primary": "#0F172A",
    "text_secondary": "#475569",
    "text_muted": "#94A3B8",
    "accent_primary": "#2563EB",
    "accent_primary_hover": "#1D4ED8",
    "accent_primary_glow": "rgba(37, 99, 235, 0.12)",
    "accent_secondary": "#4F46E5",
    "accent_secondary_hover": "#4338CA",
    "status_success": "#16A34A",
    "status_success_bg": "#DCFCE7",
    "status_warning": "#D97706",
    "status_warning_bg": "#FEF3C7",
    "status_error": "#DC2626",
    "status_error_bg": "#FEE2E2",
    "status_diff_add": "#15803D",
    "status_diff_add_bg": "#DCFCE7",
    "status_diff_del": "#B91C1C",
    "status_diff_del_bg": "#FEE2E2"
  },
  "typography": {
    "font_sans": "'Plus Jakarta Sans', 'BIZ UDPGothic', 'Hiragino Sans', 'Noto Sans JP', sans-serif",
    "font_mono": "'JetBrains Mono', 'Fira Code', Consolas, monospace",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "base": "0.875rem",
      "lg": "1rem",
      "xl": "1.125rem",
      "2xl": "1.25rem"
    },
    "tracking": {
      "tight": "-0.015em",
      "normal": "0em",
      "wide": "0.025em"
    }
  },
  "texture": {
    "acrylic_blur": "none",
    "panel_shadow": "0 4px 20px -2px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.04)",
    "subtle_glow": "none",
    "rounded": {
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "full": "9999px"
    }
  },
  "density": {
    "table_row_height": "36px",
    "input_height_sm": "28px",
    "input_height_md": "34px",
    "sidebar_width": "340px",
    "header_height": "48px",
    "footer_height": "44px"
  },
  "motion": {
    "duration_fast": "150ms",
    "duration_normal": "200ms",
    "ease_standard": [0.4, 0, 0.2, 1],
    "ease_out": [0, 0, 0.2, 1]
  },
  "zindex": {
    "table_header": 10,
    "floating_overlay": 30,
    "modal": 50,
    "toast": 100
  },
  "forbidden": [
    "ダークアクリル・半透明黒背景",
    "ネオングロー",
    "紫グラデ on 白背景",
    "大げさなAI的キャッチコピー",
    "Inter / Roboto 単体指定のフォント",
    "太いグレー枠 (border-gray-400等)",
    "無意味に広い余白による情報密度の希薄化",
    "プレースホルダーコメント",
    "同期ブロッキングによるUIフリーズ"
  ],
  "app_text_tone": {
    "language": "ja",
    "style": "semi_formal_compact",
    "sample_action": "リネーム実行",
    "sample_undo": "元に戻す",
    "sample_empty": "ここにファイルまたはフォルダをドラッグ＆ドロップ"
  }
}
